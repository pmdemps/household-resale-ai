# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (recommended) or legacy anon key:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# AI provider keys will be server-side only when AI integrations are added.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- eBay integration (all optional; the app degrades to "not set up" without them). See docs/ebay-setup.md
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName from the developer portal (used as the OAuth redirect_uri; your callback URL is attached to it there)
EBAY_RU_NAME=
# sandbox | production
EBAY_ENV=sandbox
# 32-80 chars of [A-Za-z0-9_-]; same value entered in the eBay portal for the account-deletion endpoint
EBAY_DELETION_VERIFICATION_TOKEN=
# Optional leaf category when Taxonomy suggestions are unavailable (default 88433)
EBAY_DEFAULT_CATEGORY_ID=
# Encrypts stored marketplace tokens (AES-256-GCM). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Public URL of this deployment (redirects + account-deletion endpoint). Defaults to Vercel's URL or localhost.
APP_URL=
# Bearer secret the external scheduler sends to POST /api/ebay/sync
CRON_SECRET=
# Server-only. Used by /api/ebay/sync (reads connections across households) and /api/ebay/account-deletion
# (the only role allowed to run record_ebay_account_deletion). Both answer 503 without it. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Phone notifications need nothing here: the VAPID key pair and dispatch token are made on first use and
# kept in the database (push_config). Dispatch requests go to APP_URL / the Vercel production URL above.

# --- Etsy (not implemented yet; apply for a key now, see docs/etsy-setup.md)
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=
